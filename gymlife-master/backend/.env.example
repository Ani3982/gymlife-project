# ==============================================================================
# GymLife Fitness Center - Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to .env and populate with your credentials:
# cp .env.example .env
#
# IMPORTANT: Never commit the real .env file with secrets into version control!
# ==============================================================================

# 1. DJANGO CORE CONFIGURATION
DEBUG=False
SECRET_KEY=your-super-secret-key-change-this-in-production
ALLOWED_HOSTS=127.0.0.1,localhost,your-production-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-production-frontend.com
CSRF_TRUSTED_ORIGINS=https://your-production-frontend.com

# 2. DATABASE CONFIGURATION (Supabase / PostgreSQL)
# For Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# Leave blank to fallback to local SQLite (backend/db.sqlite3) during development:
DATABASE_URL=

# 3. FIREBASE AUTH & PUSH NOTIFICATIONS (FCM)
FIREBASE_PROJECT_ID=gymlife-fitness-portal
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_CREDENTIALS_PATH=

# 4. BREVO TRANSACTIONAL SMTP EMAIL (https://app.brevo.com/settings/keys/smtp)
BREVO_SMTP_SERVER=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
DEFAULT_FROM_EMAIL=GymLife Fitness Arena <support.gymcenter@gmail.com>

# 5. REAL SMS GATEWAY - FAST2SMS (For Indian Mobile Numbers, e.g. 9876543210)
FAST2SMS_API_KEY=

# 6. OPTIONAL SMS GATEWAY - TWILIO (Worldwide SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
