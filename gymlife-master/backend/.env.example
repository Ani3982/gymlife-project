# ==============================================================================
# GymLife Fitness Center - Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to .env and populate with your credentials:
# cp .env.example .env
#
# IMPORTANT: Never commit the real .env file with secrets into version control!
# ==============================================================================

# 1. DJANGO CORE CONFIGURATION
DEBUG=True
SECRET_KEY=your-django-secret-key-change-this-in-production
ALLOWED_HOSTS=127.0.0.1,localhost

# 2. BREVO TRANSACTIONAL SMTP EMAIL (https://app.brevo.com/settings/keys/smtp)
# Brevo provides free transactional SMTP delivery.
# Server: smtp-relay.brevo.com
# Port: 587 (TLS)
# Login: Your Brevo registered email (e.g. your-login@smtp-brevo.com)
# Key: Your Brevo SMTP master key (e.g. xsmtpsib-...)
BREVO_SMTP_SERVER=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
DEFAULT_FROM_EMAIL=GymLife Fitness Arena <support.gymcenter@gmail.com>

# 3. REAL SMS GATEWAY - FAST2SMS (For Indian Mobile Numbers, e.g. 9876543210)
# Free account at https://www.fast2sms.com -> Dev API Key
FAST2SMS_API_KEY=

# 4. OPTIONAL SMS GATEWAY - TWILIO (Worldwide SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
