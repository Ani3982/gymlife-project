# ==============================================================================
# GymLife Frontend - Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure with your credentials:
# cp .env.example .env
#
# IMPORTANT: Never commit your real .env file with live secrets to version control!
# ==============================================================================

# 1. Official Google Cloud OAuth 2.0 Web Client ID
# (Obtain from https://console.cloud.google.com/apis/credentials)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 2. Firebase Web App Credentials (Optional)
# (Obtain from https://console.firebase.google.com/)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
